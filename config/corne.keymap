 *
 * 5x3 Corne layout — ergonomic, Windows-oriented, programmer-friendly.
 * Home-row mods (Miryoku-style): GUI / ALT / CTRL / SHIFT on A S D F and ; L K J.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Hold both thumb layer-taps → layer 3 (functions / BT / mouse)
        layer3 {
            bindings = <&mo 3>;
            key-positions = <31 33>;
        };

        // C + B = copy
        copy {
            bindings = <&kp LC(C)>;
            key-positions = <22 24>;
        };

        // V + B = paste
        paste {
            bindings = <&kp LC(V)>;
            key-positions = <23 24>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |   (home-row mods)
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |
            //             | ESC |LWR/SPC| TAB |  | ENT |RSE/BSP| DEL |

            bindings = <
&kp Q          &kp W         &kp E          &kp R          &kp T              &kp Y      &kp U          &kp I          &kp O         &kp P
&hm LGUI A     &hm LALT S    &hm LCTRL D    &hm LSHFT F    &kp G              &kp H      &hm RSHFT J    &hm RCTRL K    &hm LALT L    &hm RGUI SEMI
&kp Z          &kp X         &kp C          &kp V          &kp B              &kp N      &kp M          &kp COMMA      &kp DOT       &kp FSLH
                                            &kp ESC        &lt 1 SPACE    &kp TAB    &kp ENTER  &lt 2 BSPC     &kp DEL
            >;
        };

        lower_layer {
            // ---------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |
            // |     |     |     |     |     |   | LFT | DWN |  UP | RGT |  '  |
            // |     |     |     |     |     |   | HOM |PGDN |PGUP | END |  \  |
            //                |     |     |     |     |     |     |

            bindings = <
&kp N1     &kp N2     &kp N3     &kp N4     &kp N5         &kp N6     &kp N7     &kp N8     &kp N9      &kp N0
&trans     &trans     &trans     &trans     &trans         &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT   &kp SQT
&trans     &trans     &trans     &trans     &trans         &kp HOME   &kp PG_DN  &kp PG_UP  &kp END     &kp BSLH
                                 &trans     &trans     &trans         &trans     &trans     &trans
            >;
        };

        raise_layer {
            // ---------------------------------------------------------------------------
            // |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |
            // |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  `  |
            // |     |     |     |     |     |   |  _  |  +  |  {  |  }  |  |  |
            //                |     |     |     |     |     |     |

            bindings = <
&kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR
&trans     &trans     &trans     &trans     &trans         &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &kp GRAVE
&trans     &trans     &trans     &trans     &trans         &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE
                                 &trans     &trans     &trans         &trans     &trans     &trans
            >;
        };

        layer_3 {
            // ---------------------------------------------------------------------------
            // | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 |
            // |BCLR | BT1 | BT2 | BT3 | BT4 |   | MLF | MDN | MUP | MRT | F11 |
            // |     |     |     |     |     |   | LCK | RCK | MCK |VOL- | F12 |
            //                |     |     |     |     |     |     |

            bindings = <
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5           &kp F6           &kp F7          &kp F8          &kp F9           &kp F10
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &kp F11
&trans      &trans        &trans        &trans        &trans           &mkp LCLK        &mkp RCLK       &mkp MCLK       &kp C_VOL_DN     &kp F12
                                        &trans        &trans     &trans                &trans          &trans          &trans
            >;
        };
    };
};
